<?xml version="1.0" encoding="utf-8"?>
<!--
  M5c 浮层背景：**第一版的黑底**（近黑、半透明但压得住背景）+ 细描边 + 圆角。
  具体颜色由 OverlayController.COLOR_CARD 在代码里设（常量集中，方便以后调），
  这里的 solid 是同一份颜色，只作为布局预览的兜底。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E6161C24" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
