    <string name="label_pair_code">6 位配对码</string>
    <string name="hint_pair_code">电脑端启动时打印的 6 位数字</string>
    <string name="btn_pair_connect">连接</string>
    <string name="pair_help">电脑端运行 channel-server 后会打印一个 6 位码，5 分钟内有效、用一次就失效。\n手机与电脑要在同一个局域网，或用 adb reverse 把 8788 端口转过来（这时地址填 ws://127.0.0.1:8788）。</string>

    <string name="title_debug">通道调试</string>
    <string name="hint_message">输入一条文本，发给电脑端</string>
    <string name="btn_send">发送</string>
    <string name="btn_reconnect">重新连接</string>
    <string name="debug_help">发出的和收到的都会带时间戳显示在下面；断线时会显示「重连中…」。\n按住说话录完后会自动上传：显示「上传中…」→「识别中…」→「语音：识别文字」；失败时点那一行即可重试一次。</string>
    <string name="debug_voice_prefix">语音</string>

