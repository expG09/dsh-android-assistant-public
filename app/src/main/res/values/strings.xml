    <!-- M5c 悬浮窗（SYSTEM_ALERT_WINDOW 浮层 + 后台可弹界面） -->
    <string name="section_overlay">悬浮窗</string>
    <string name="label_overlay_switch">开启悬浮窗（可拖动，任意界面按住说话）</string>
    <string name="hint_overlay_on">浮层在屏幕上：按住下边的「按住说话」录音、松手结束；录音中（含唤醒词自动开录）那个按钮会变成「停止」，点一下立刻收尾上传。拖上边的状态条可移动，拖到左右边缘会自动吸附，位置会记住；点状态条看最近一条命令。</string>
    <string name="hint_overlay_off">浮层没显示：后台收到的命令只能发一条通知，点通知才能打开界面。</string>
    <!-- decision.md 要求这句不改口径，出现在设置页与浮窗开关下面 -->
    <string name="hint_overlay_degrade">未开启悬浮窗时，后台无法弹出命令界面，必须手动打开 App 后才能执行推送类操作。</string>
