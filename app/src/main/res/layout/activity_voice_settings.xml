<?xml version="1.0" encoding="utf-8"?>
<!-- M6a 语音回复设置（M6 起统一顶栏与主题色）：开关、音色、试听、缓存保留期与清理。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/yyBg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/view_topbar" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/yyDivider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_speak"
                android:textColor="?attr/yyText"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/sw_speak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_speak_switch"
                android:textColor="?attr/yyText"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_speak_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/yyTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_voice"
                android:textColor="?attr/yyText"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_voice_stella"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/voice_stella"
                    android:textColor="?attr/yyText"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rb_voice_tide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/voice_tide"
                    android:textColor="?attr/yyText"
                    android:textSize="15sp" />
            </RadioGroup>

            <Button
                android:id="@+id/btn_audition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="48dp"
                android:text="@string/btn_voice_audition" />

            <TextView
                android:id="@+id/tv_audition_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/hint_voice_audition"
                android:textColor="?attr/yyTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/section_tts_cache"
                android:textColor="?attr/yyText"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cache_usage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/tts_usage_placeholder"
                android:textColor="?attr/yyText"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_tts_keep"
                android:textColor="?attr/yyText"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_keep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_keep_7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/tts_keep_7"
                    android:textColor="?attr/yyText"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rb_keep_30"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/tts_keep_30"
                    android:textColor="?attr/yyText"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rb_keep_never"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/tts_keep_never"
                    android:textColor="?attr/yyText"
                    android:textSize="15sp" />
            </RadioGroup>

            <Button
                android:id="@+id/btn_clear_tts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/btn_clear_tts" />

            <TextView
                android:id="@+id/tv_cache_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/hint_tts_cache"
                android:textColor="?attr/yyTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/hint_tts_how_it_works"
                android:textColor="?attr/yyTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
