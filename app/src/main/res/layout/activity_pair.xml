<?xml version="1.0" encoding="utf-8"?>
<!-- M2 配对页（M6 起统一顶栏与主题色）：填地址 + 6 位配对码 → 换 token → 通道自动连上 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/yyBg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/view_topbar" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/yyDivider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_server_url"
                android:textColor="?attr/yyText"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/et_server_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_server_url"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="?attr/yyText"
                android:textColorHint="?attr/yyTextSecondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/label_pair_code"
                android:textColor="?attr/yyText"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/et_pair_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_pair_code"
                android:inputType="number"
                android:maxLength="6"
                android:maxLines="1"
                android:textColor="?attr/yyText"
                android:textColorHint="?attr/yyTextSecondary" />

            <Button
                android:id="@+id/btn_pair_connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_pair_connect" />

            <TextView
                android:id="@+id/tv_pair_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="—"
                android:textColor="?attr/yyText"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_pair_server_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/yyTextSecondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_pair_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="?attr/yyTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/pair_help"
                android:textColor="?attr/yyTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
