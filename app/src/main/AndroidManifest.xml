<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 通知（Android 13+ 需要运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 前台服务本体 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- specialUse 类型在 Android 14+ 必须声明这个权限，否则 startForeground 直接抛 SecurityException -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- M1 先只声明、不申请麦克风；M4 真录音时再按需申请 RECORD_AUDIO -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- M3a：按住说话 / 监听时才用；第一次打开「监听开关」时申请，安装时不申请 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 电池优化白名单引导 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      M5c 悬浮窗（SYSTEM_ALERT_WINDOW）：
        - 设置页一个开关（默认关），打开时才跳系统授权页（ACTION_MANAGE_OVERLAY_PERMISSION）；
        - 浮层用 WindowManager 叠加（TYPE_APPLICATION_OVERLAY），不是 Activity；
        - 它同时是「后台启动 Activity」的系统豁免之一：有它，后台收到命令才能真的把界面弹起来。
        权限清单（docs/dev/权限盘点.md）里属于「可选」档，安装时不申请，由用户显式打开。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- M2 通道：WebSocket / 配对 HTTP -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- M2 通道：网络变化时立刻重连 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- M5：发送提醒类广播不需要权限；open_app 只按「有 LAUNCHER 入口的应用」查，见下面的 <queries> -->
    <!--
      M5 alarm：`AlarmClock.ACTION_SET_ALARM` 的接收方（例如本机 com.android.BBKClock 的
      HandleApiCalls）自己声明了 `android.permission.SET_ALARM` 保护，调用方必须声明这个
      授权才能查到/拉起它。它是安装期权限，没有运行时弹窗，也不需要用户在设置里点什么。
    -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!--
      M5 包可见性（Android 11+ 默认只能看到自己）：
      不申请 QUERY_ALL_PACKAGES（权限盘点里列为「可选」，而且范围过宽），
      改成用 <queries> 精确声明我们要「看见」的那几类：
        1) 有 LAUNCHER 入口的应用 → open_app 按中文名找包名（queryIntentActivities(MAIN/LAUNCHER)）；
        2) 处理 tel: / smsto: / geo: / 网页 / 系统搜索 的应用 → 判断 Intent 有没有东西响应；
        3) 日历的 INSERT（ACTION_INSERT + vnd.android.cursor.dir/event）→ calendar 能不能拉起编辑器。
      桌面小组件（com.vivo.*widget 之类）不在 LAUNCHER 集合里，天然被排除。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
    </queries>

    <application
        android:name=".AssistantApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M6 聊天页：消息列表 + 底部输入区（QQ 形态），见 docs/dev/M6 模块开发文档 -->
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:label="聊天"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- M6 设置：主设置页只列分类，具体项在八个二级页里 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="设置"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SettingsSectionActivity"
            android:exported="false"
            android:label="设置"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- M2 配对页 / 调试页：只在 App 内部可达 -->
        <activity
            android:name=".PairActivity"
            android:exported="false"
            android:label="@string/title_pair"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DebugActivity"
            android:exported="false"
            android:label="@string/title_debug"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- M6a 语音回复设置（开关 / 音色 / 试听 / 缓存）：从 设置 › 语音 进来 -->
        <activity
            android:name=".VoiceSettingsActivity"
            android:exported="false"
            android:label="@string/title_voice_settings"
            android:screenOrientation="portrait" />

        <!--
          foregroundServiceType=specialUse|microphone：
            - dataSync 在 Android 15+ 有 6 小时/24 小时时限，且不允许从 BOOT_COMPLETED 拉起；
            - microphone 类型只在 M3a 监听开关打开且已有 RECORD_AUDIO 时由代码动态加上
              （否则启动时没有权限会直接 SecurityException），带上它才允许后台采集；
            - specialUse 没有时限，也能从开机广播拉起。
        -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="voice_assistant_keepalive" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
