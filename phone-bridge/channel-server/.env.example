# phone-bridge / channel-server 的环境变量模板
# 用法：复制为 .env（或直接启动插件 —— 缺 PHONE_BRIDGE_TOKEN 时插件会自动生成并写回 .env）。
# 不要提交 .env；这里只放键名与说明，不放真实值。

# 桥端共享密钥（插件 <-> channel-server）。留空/缺失时，插件启动会自动生成一个随机值，
# 写进同目录的 .env，并在日志里说明「已生成新 token」。已有值不会被覆盖。
PHONE_BRIDGE_TOKEN=

# DeepSeek ASR / TTS 用。缺失不算错误：配对、文本投递照常，只是语音识别/合成不可用。
DEEPSEEK_API_KEY=

# 以下都可选，默认值见 server.js（一般不用改）
# CHANNEL_PORT=8788
# CHANNEL_HOST=0.0.0.0
# CHANNEL_DATA_DIR=./data
# CHANNEL_PAIR_TTL_MS=300000
# CHANNEL_DEV=1
